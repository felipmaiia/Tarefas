<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CheckBox de tarefa completa -->
        <CheckBox
            android:id="@+id/cbCompletedTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:enabled="false"/>

        <!-- LinearLayout para organizar o título e a descrição -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp">

            <!-- Título do item -->
            <TextView
                android:id="@+id/tvTitleTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Example title"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#003366"/>

            <!-- Descrição do item, com a restrição de uma linha -->
            <TextView
                android:id="@+id/tvDescriptionTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Example description"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#003366"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Linha abaixo do item -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"
        android:focusable="false" />

</LinearLayout>